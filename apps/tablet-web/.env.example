# Required for WebView development (use your dev machine's IP address)
# When tablet-app loads tablet-web in a WebView, "localhost" refers to the mobile device.
# Set this to your development machine's actual IP address so API/SSE calls work.
#
# Example: If your dev machine IP is 192.168.1.100:
# NEXT_PUBLIC_API_URL=http://192.168.1.100:4000/v1
#
# For production, set this to your actual API server URL:
# NEXT_PUBLIC_API_URL=https://api.your-domain.com/v1

NEXT_PUBLIC_API_URL=http://YOUR_DEV_MACHINE_IP:4000/v1
