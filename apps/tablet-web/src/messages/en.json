      "payment": {
        "question": "What payment methods are available?",
        "answer": "We accept Kakao Pay, Naver Pay, and credit cards."
      },
      "gameRules": {
        "question": "Can I get game rule explanations?",
        "answer": "Yes, tap 'I want game instructions' on the game detail screen and a staff member will explain."
      }
